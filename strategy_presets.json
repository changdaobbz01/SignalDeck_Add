              "d_name": "d",
              "j_name": "j"
            }
          },
          "checks": {
            "pass": [
              "close > ma20",
              "ma20 >= ma60",
              "dif >= dea",
              "k >= d"
            ],
            "low_zone": [
              "close <= ma20 * 1.08",
              "between('j', 0, 55)"
